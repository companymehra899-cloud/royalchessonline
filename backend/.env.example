# Backend Configuration
# Copy this file to .env and fill in your values

# MongoDB Connection
MONGO_URL=mongodb://localhost:27017
DB_NAME=royal_chess_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-required-here

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin Configuration (comma-separated emails)
ADMIN_EMAILS=admin@chess.local,support@chess.local

# League Configuration
LEAGUE_CLAIM_URL=https://chess.local/claim-prize
LEAGUE_DURATION_DAYS=3
LEAGUE_MIN_PLAYERS=200

# Server Configuration
DEBUG=True
HOST=0.0.0.0
PORT=8000
