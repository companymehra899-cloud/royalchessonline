# MongoDB connection
MONGO_URL=mongodb://localhost:27017
DB_NAME=test_database

# JWT signing secret. REQUIRED — the server refuses to start without it.
# Generate a strong one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated list of admin email addresses (case-insensitive).
# Users with these emails are granted the 'admin' role on registration/login.
# Example: ADMIN_EMAILS=ops@royalchess.in,admin@royalchess.in
ADMIN_EMAILS=

# External league-prize claim destination shown to winners (leave empty to use
# an in-app message instead of a URL).
LEAGUE_CLAIM_URL=
